{
  "name": "city-life-simulator",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A portable Chinese-city life simulation in Simplified Chinese, Traditional Chinese and English.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs --dir dist",
    "preview": "node scripts/dev-server.mjs --dir dist",
    "build": "node scripts/build.mjs",
    "build:mini": "node scripts/build-mini.mjs",
    "build:minigame": "node scripts/build-mini.mjs && node scripts/build-minigame.mjs",
    "test:mini": "node --test scripts/test-mini.mjs",
    "test:minigame": "node --test scripts/test-minigame.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "html2canvas": "1.4.1"
  }
}

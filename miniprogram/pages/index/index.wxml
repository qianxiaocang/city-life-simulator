<view style="padding-top:{{navHeight}}px" class="screen {{theme === 'dark' ? 'dark' : ''}} {{view === 'life' ? 'screen-life' : view === 'ending' ? 'screen-ending' : ''}}">
  <view class="navigation-background" style="height:{{navHeight}}px" aria-hidden="true"></view>
  <view wx:if="{{toast}}" class="toast" style="top:{{navHeight + 8}}px" role="alert">{{toast}}</view>
  <view wx:if="{{view !== 'home' && view !== 'ending'}}" class="page-header" style="top:{{navHeight}}px"><view aria-role="button" hover-class="tap-hover" class="tap-control back" data-action="back" bindtap="onAction" aria-label="{{ui.back}}">‹</view><text class="header-title">{{view === 'life' ? ui.living : view === 'archive' ? ui.archive : view === 'certificate' ? ui.certificate : ui.lifetime}}</text><view class="header-space"></view></view>

  <view wx:if="{{view === 'home'}}" class="content home">
    <view class="home-top"><text class="brand">{{ui.brand}}</text><view class="home-controls"><picker range="{{languageLabels}}" range-key="label" value="{{languageIndex}}" bindchange="onSetting" data-key="language"><view class="language"><text class="language-icon">文</text><text>{{languageLabels[languageIndex].label}}</text><text class="chevron">⌄</text></view></picker><view aria-role="button" hover-class="tap-hover" class="tap-control theme-control" data-action="theme" bindtap="onAction" aria-label="{{ui.theme}}">{{theme === 'dark' ? '☀' : '◐'}}</view></view></view>
    <view class="intro"><view class="eyebrow"><view class="eyebrow-line"></view>{{ui.eyebrow}}</view><view class="hero-title">{{ui.brand}}<view class="title-rule"></view></view><text class="lede">{{ui.heroText}}</text><image wx:if="{{homeCover}}" class="hero-art" src="{{homeCover}}" mode="aspectFill"/><view wx:else class="hero-placeholder"><view class="building b1"></view><view class="building b2"></view><view class="building b3"></view><view class="pixel-family">♟ ♟ ♟</view></view></view>
    <view wx:if="{{resume}}" class="resume"><view><text class="resume-name">{{resume.name}} · {{resume.age}}</text><text class="muted block">{{resume.place}}</text></view><view aria-role="button" hover-class="tap-hover" class="tap-control small-primary" data-action="resume" bindtap="onAction">{{ui.resume}}</view></view>
    <view class="card registration"><view class="section-head"><text class="section-title">{{ui.pastPresent}}</text><text class="count-pill">{{ui.locationCount}}</text></view><view class="segments era-tabs"><view aria-role="button" hover-class="tap-hover" class="tap-control {{settings.world === 'past' ? 'selected' : ''}}" data-action="world" data-value="past" bindtap="onAction">{{ui.past}}</view><view aria-role="button" hover-class="tap-hover" class="tap-control {{settings.world === 'now' ? 'selected' : ''}}" data-action="world" data-value="now" bindtap="onAction">{{ui.now}}</view></view><text class="field-hint">{{settings.world === 'past' ? ui.pastHint : ui.nowHint}}</text><view wx:if="{{settings.world === 'past'}}" class="picker-row"><text>{{ui.birthYear}}</text><picker range="{{years}}" range-key="label" value="{{yearIndex}}" bindchange="onSetting" data-key="birthYear"><view class="picker-value">{{years[yearIndex].label}}<text class="chevron">⌄</text></view></picker></view><view class="advanced"><view aria-role="button" hover-class="tap-hover" class="tap-control advanced-toggle" data-action="toggle-advanced" bindtap="onAction"><text>{{ui.birthSettings}}</text><text class="arrow {{advancedOpen ? 'up' : ''}}">⌄</text></view><view wx:if="{{advancedOpen}}" class="advanced-body"><view class="field"><text class="field-label">{{ui.scope}}</text><picker range="{{regions}}" range-key="label" value="{{regionIndex}}" bindchange="onSetting" data-key="scope"><view class="picker-value">{{regions[regionIndex].label}}<text class="chevron">⌄</text></view></picker></view><view class="field"><text class="field-label">{{ui.province}}</text><picker range="{{provinces}}" range-key="label" value="{{provinceIndex}}" bindchange="onSetting" data-key="province"><view class="picker-value">{{provinces[provinceIndex].label}}<text class="chevron">⌄</text></view></picker></view><view class="field"><text class="field-label">{{ui.pace}}</text><view class="segments pace-tabs"><view aria-role="button" hover-class="tap-hover" wx:for="{{[30,60,90]}}" wx:key="*this" class="tap-control {{settings.pace === item ? 'selected' : ''}}" data-action="pace" data-value="{{item}}" bindtap="onAction">{{item}} {{ui.minutes}}</view></view></view></view></view><view aria-role="button" hover-class="tap-hover" class="tap-control primary birth-button" data-action="born" bindtap="onAction">{{ui.born}}<text>↗</text></view></view>
    <view class="home-memorial"><view class="section-head"><text class="section-title small-title">{{ui.rememberedLives}}</text><view aria-role="button" hover-class="tap-hover" class="tap-control text-link" data-action="archive" bindtap="onAction">{{ui.viewAll}} ↗</view></view><view wx:if="{{memories.length}}" class="memorial-previews"><view aria-role="button" hover-class="tap-hover" wx:for="{{memories}}" wx:key="id" class="tap-control memorial-mini" data-action="review" data-value="{{item.id}}" bindtap="onAction"><image src="{{item.cover}}" mode="aspectFill"/><view><text class="mini-name">{{item.name}}</text><text class="muted block">{{item.date}}</text></view></view></view><view wx:else class="empty-mini"><text>✧</text><text>{{ui.memorialEmpty}}</text></view></view>
  </view>

  <view wx:elif="{{view === 'certificate'}}" class="content certificate-page"><view class="card certificate"><image wx:if="{{person.cover}}" class="cover" src="{{person.cover}}" mode="aspectFill"/><view class="card-pad"><text class="eyebrow">{{ui.certificate}}</text><text class="person-name birth-name">{{person.name}}</text><text class="muted block">{{person.meta}}</text><text class="birth-story">{{person.birthText}}</text><view class="facts-grid"><view wx:for="{{person.facts}}" wx:key="label" class="fact"><text class="muted">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view><text class="section-title small-title companion-title">{{ui.sameMoment}}</text><text class="muted block companion-hint">{{ui.companionHint}}</text><view class="companions"><view wx:for="{{person.companions}}" wx:key="name" class="companion"><text>{{item.name}}</text><text class="muted block">{{item.meta}}</text></view></view></view><view class="certificate-actions"><view aria-role="button" hover-class="tap-hover" class="tap-control secondary" data-action="birth-card" bindtap="onAction">{{ui.birthCard}}</view><view aria-role="button" hover-class="tap-hover" class="tap-control primary" data-action="begin" bindtap="onAction">{{ui.begin}}</view></view><view aria-role="button" hover-class="tap-hover" wx:if="{{photoReady}}" class="tap-control birth-save-photo" data-action="save-photo" bindtap="onAction">↓ {{ui.savePhoto}}</view></view></view>

  <view wx:elif="{{view === 'life'}}" class="content life-content"><view class="card overview"><view class="rainbow"></view><view class="overview-top"><text class="eyebrow">{{ui.overview}}</text><view class="overview-top-right"><text>{{person.year}} · {{person.age}}</text><view aria-role="button" hover-class="tap-hover" class="tap-control collapse" data-action="toggle-overview" bindtap="onAction">{{settings.overviewCollapsed ? ui.expand : ui.collapse}} <text>{{settings.overviewCollapsed ? '⌄' : '⌃'}}</text></view></view></view><view class="overview-person"><view class="avatar">{{person.initial}}</view><view class="person-copy"><text class="person-name">{{person.name}}</text><text class="person-meta">{{person.meta}}</text></view></view><view class="stats"><view wx:for="{{person.stats}}" wx:key="key" class="stat {{item.key}}"><text class="stat-label">{{item.label}}</text><text class="stat-value">{{item.value}}</text><view class="stat-track"><view style="width:{{item.value}}%"></view></view></view></view><view wx:if="{{!settings.overviewCollapsed}}" class="overview-extra"><view class="finances"><view wx:for="{{person.finances}}" wx:key="label"><text class="muted block">{{item.label}}</text><text class="finance-value">{{item.value}}</text></view></view><view aria-role="button" hover-class="tap-hover" class="tap-control details-entry" data-action="life-details" bindtap="onAction"><text>{{ui.lifeDetails}}</text><text>↗</text></view><view wx:if="{{automatic}}" class="auto-notice"><view aria-role="button" hover-class="tap-hover" class="tap-control" data-action="take-control" bindtap="onAction">{{ui.takeControlHint}}</view></view></view></view>
    <view class="feed"><view wx:for="{{logs}}" wx:key="id" class="feed-row {{item.type}}"><text class="feed-age">{{item.age}}</text><view class="feed-copy"><text wx:if="{{item.date}}" class="record-date">{{item.date}}</text><text class="record-text">{{item.text}}</text><text wx:if="{{item.effects}}" class="effects">{{item.effects}}</text></view><view aria-role="button" hover-class="tap-hover" class="tap-control star {{item.starred ? 'starred' : ''}}" data-action="star" data-value="{{item.id}}" bindtap="onAction" aria-label="{{ui.favorite}}">{{item.starred ? '★' : '☆'}}</view></view><view aria-role="button" hover-class="tap-hover" wx:if="{{hasEarlier}}" class="tap-control earlier" data-action="earlier" bindtap="onAction">{{ui.earlier}} ↑</view></view>
    <view class="playback"><view class="progress-line"><text>{{ui.thisYear}} · {{person.year}}</text><text class="progress-number">{{progress}}% <text>{{fast ? '» ' : ''}}{{speed}}×</text></text></view><view class="progress-track"><view style="width:{{progress}}%"></view></view><view class="playback-status"><text>{{person.career}}</text><text>{{person.income}} / {{ui.yearUnit}}</text></view><view class="speed-row"><view aria-role="button" hover-class="tap-hover" class="tap-control control pause-control {{paused ? 'active' : ''}}" data-action="pause" bindtap="onAction">{{paused ? ui.play : ui.pause}}</view><view aria-role="button" hover-class="tap-hover" wx:for="{{speeds}}" wx:key="*this" class="tap-control control {{speed === item ? 'active' : ''}}" data-action="speed" data-value="{{item}}" bindtap="onAction">{{item}}×</view></view><view class="action-row"><view aria-role="button" hover-class="tap-hover" class="tap-control control next-control {{fast ? 'active' : ''}}" data-action="next" bindtap="onAction">{{ui.next}} »</view><view aria-role="button" hover-class="tap-hover" class="tap-control control" data-action="year" bindtap="onAction">{{ui.oneYear}}</view><view aria-role="button" hover-class="tap-hover" class="tap-control control {{automatic ? 'active' : ''}}" data-action="autopilot" bindtap="onAction">{{ui.autopilot}}</view><view aria-role="button" hover-class="tap-hover" wx:if="{{hasPending && modal !== 'choice'}}" class="tap-control control" data-action="pending" bindtap="onAction">{{ui.choice}}</view></view></view>
  </view>

  <view wx:elif="{{view === 'ending'}}" class="ending"><view class="ending-portrait"><image wx:if="{{person.cover}}" class="cover" src="{{person.cover}}" mode="aspectFill"/><text class="ending-name">{{person.name}}</text><text class="ending-date">{{person.date}}</text><text class="ending-narrative">{{endingText}}</text></view><view class="ending-actions"><view aria-role="button" hover-class="tap-hover" class="tap-control primary" data-action="capture-ending" bindtap="onAction">{{ui.capture}}</view><view aria-role="button" hover-class="tap-hover" class="tap-control secondary" data-action="end-done" bindtap="onAction">{{ui.viewReport}}</view></view><view aria-role="button" hover-class="tap-hover" wx:if="{{photoReady}}" class="tap-control save-photo-link" data-action="save-photo" bindtap="onAction">↓ {{ui.savePhoto}}</view></view>

  <view wx:elif="{{view === 'archive'}}" class="content archive-page"><view class="archive-heading"><text class="eyebrow">MEMORIAL HALL</text><text class="page-title">{{ui.archive}}</text><text class="muted block">{{ui.archiveIntro}}</text></view><view class="card hall-facts"><view wx:for="{{archiveFacts}}" wx:key="label"><text class="hall-value">{{item.value}}</text><text class="muted">{{item.label}}</text></view></view><view wx:if="{{archiveList.length}}" class="archive-list"><view wx:for="{{archiveList}}" wx:key="id" class="card memorial-card"><view aria-role="button" hover-class="clickable-hover" class="memorial-open" data-action="review" data-value="{{item.id}}" bindtap="onAction"><image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="memorial-card-body"><text class="memorial-name">{{item.name}}</text><text class="muted block">{{item.date}}</text><text class="memorial-tagline">{{item.tagline}}</text><text class="memorial-review-preview">{{item.review}}</text></view></view><view aria-role="button" hover-class="tap-hover" class="tap-control candle" data-action="candle" data-value="{{item.id}}" bindtap="onAction">🕯 {{item.candles}}</view></view></view><view wx:else class="card empty-hall"><text>✧</text><text>{{ui.noLives}}</text><view aria-role="button" hover-class="tap-hover" class="tap-control primary" data-action="home" bindtap="onAction">{{ui.born}}</view></view></view>

  <view wx:elif="{{view === 'report'}}" class="content report-page"><view class="card report-person"><image wx:if="{{person.cover}}" class="cover" src="{{person.cover}}" mode="aspectFill"/><view class="report-person-body"><text class="person-name">{{person.name}}</text><text class="muted block">{{person.date}}</text><text class="report-tagline">{{person.tagline}}</text><text class="report-meta">{{person.reportMeta}}</text><view class="facts-grid report-facts"><view wx:for="{{person.facts}}" wx:key="label" class="fact"><text class="muted">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view><view class="review-note"><text>{{person.review}}</text><view aria-role="button" hover-class="clickable-hover" wx:if="{{person.canEditReview}}" class="review-edit" data-action="edit-review" bindtap="onAction">✎ {{ui.writeWords}}</view></view><view aria-role="button" hover-class="tap-hover" class="tap-control candle" data-action="candle" data-value="{{person.id}}" bindtap="onAction">🕯 {{person.candles}}</view></view></view><view wx:if="{{momentGroups.length}}" class="moments"><text class="section-title">{{ui.lifeMoments}}</text><view wx:for="{{momentGroups}}" wx:key="title" class="moment-group"><view class="decade-head"><text>{{item.title}}</text><text class="muted">{{item.years}}</text></view><view class="moment-grid"><view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="moment"><image wx:if="{{event.cover}}" src="{{event.cover}}" mode="aspectFill"/><view class="moment-date"><text>{{event.age}}</text><text class="muted">{{event.year}}</text></view><text>{{event.text}}</text></view></view></view><view aria-role="button" hover-class="tap-hover" wx:if="{{hasMoreMoments}}" class="tap-control earlier" data-action="more-moments" bindtap="onAction">{{ui.moreMoments}} ↓</view></view><view class="whole-life"><text class="section-title">{{ui.thisLife}}</text><view class="card record-list"><view wx:for="{{logs}}" wx:key="id" class="record-row {{item.type}}"><text class="record-age">{{item.age}}</text><text class="record-text">{{item.text}}</text></view><view aria-role="button" hover-class="tap-hover" wx:if="{{hasEarlier}}" class="tap-control earlier" data-action="earlier" bindtap="onAction">{{ui.earlier}}</view></view></view><view wx:if="{{person.journal.length}}" class="journal-section"><text class="section-title">{{ui.journal}}</text><view class="card journal-list"><view wx:for="{{person.journal}}" wx:key="index" class="journal-entry"><text class="muted">{{item.year}} · {{item.age}}</text><text class="journal-text">{{item.text}}</text></view></view></view><view wx:if="{{!fromArchive}}" class="report-bottom"><view aria-role="button" hover-class="tap-hover" wx:if="{{!memorialSaved}}" class="tap-control primary" data-action="memorialize" bindtap="onAction">{{ui.memorialize}}</view><view wx:else class="saved-notice">✓ {{ui.memorialSaved}}</view><view aria-role="button" hover-class="tap-hover" class="tap-control secondary" data-action="replay" bindtap="onAction">{{ui.replay}}</view></view></view>

  <movable-area wx:if="{{view === 'home'}}" class="music-area"><movable-view class="music-control {{musicPlaying ? 'playing' : ''}}" direction="all" x="{{musicX}}" y="{{musicY}}" damping="40" bindchange="onMusicMove"><view aria-role="button" hover-class="tap-hover" class="tap-control" data-action="music" bindtap="onAction" aria-label="{{ui.music}}"><text class="music-note">♪</text><view class="music-bars"><view></view><view></view><view></view></view></view></movable-view></movable-area>

  <view wx:if="{{modal}}" class="modal-backdrop" catchtouchmove="noop"><view class="modal-panel {{modal === 'details' ? 'details-panel' : ''}}"><view class="modal-head"><text>{{modal === 'choice' ? ui.choice : modal === 'details' ? ui.lifeDetails : ui.writeWords}}</text><view aria-role="button" hover-class="tap-hover" class="tap-control modal-close" data-action="close-modal" bindtap="onAction">{{ui.close}}</view></view><scroll-view scroll-y class="modal-scroll"><view wx:if="{{modal === 'choice'}}" class="modal-body choice-body"><text class="eyebrow">{{choice.meta}}</text><text class="choice-title">{{choice.title}}</text><text class="choice-description">{{choice.description}}</text><textarea wx:if="{{choice.input}}" class="review-input reflection-input" maxlength="200" placeholder="{{ui.reflectionPlaceholder}}" bindinput="onReflectionInput"/><view class="choice-options"><view aria-role="button" hover-class="choice-hover" wx:for="{{choice.options}}" wx:key="id" class="choice-option" data-action="choose" data-value="{{item.id}}" bindtap="onAction"><text class="option-index">{{index + 1}}</text><view><text class="option-label">{{item.label}}</text><text wx:if="{{item.description}}" class="option-description">{{item.description}}</text></view></view></view><view aria-role="button" hover-class="tap-hover" wx:if="{{automatic}}" class="tap-control text-link take-control" data-action="take-control" bindtap="onAction">{{ui.takeControl}}</view></view><view wx:elif="{{modal === 'details'}}" class="modal-body"><view class="details-person"><view class="avatar">{{person.initial}}</view><view><text class="person-name">{{person.name}}</text><text class="muted block">{{person.year}} · {{person.age}}</text></view></view><view class="detail-section"><text class="detail-section-title">{{ui.identity}}</text><view class="facts-grid"><view wx:for="{{person.facts}}" wx:key="label" class="fact"><text class="muted">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view></view><view class="detail-section"><text class="detail-section-title">{{ui.family}}</text><view wx:for="{{person.family}}" wx:key="name" class="family-row"><text class="muted family-label">{{item.label}}</text><text class="family-name">{{item.name}}</text><text class="muted family-detail">{{item.detail}}</text></view></view><view class="detail-section"><text class="detail-section-title">{{ui.assets}}</text><view class="facts-grid"><view wx:for="{{person.assets}}" wx:key="label" class="fact"><text class="muted">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view></view><view class="detail-section"><text class="detail-section-title">{{ui.sameMoment}}</text><view class="companions"><view wx:for="{{person.companions}}" wx:key="name" class="companion {{item.gone ? 'companion-gone' : ''}}"><text>{{item.name}}</text><text class="muted block">{{item.meta}}</text><text wx:if="{{item.status}}" class="companion-status">{{item.status}}</text></view></view><text class="muted block detail-note">{{ui.companionHint}}</text></view><view class="detail-section"><text class="detail-section-title">{{ui.lifeMap}}</text><view class="year-map"><view wx:for="{{person.yearMap}}" wx:key="age" class="year-cell {{item.current ? 'current-year' : ''}}" style="background:{{item.color}}"></view></view><view class="map-legend"><text>0</text><text>48</text><text>{{person.age}}</text></view><text class="muted block detail-note">{{ui.lifeMapHint}}</text></view><view class="detail-section"><text class="detail-section-title">{{ui.survival}}</text><view wx:for="{{person.survivalPoints}}" wx:key="age" class="survival-row"><text>{{item.age}}</text><view class="survival-track"><view style="width:{{item.percent}}%"></view></view><text class="survival-percent">{{item.percent}}%</text></view><text class="muted block detail-note">{{ui.survivalHint}}</text></view></view><view wx:elif="{{modal === 'review'}}" class="modal-body review-body"><text class="muted block review-help">{{ui.reviewHelp}}</text><text class="field-label">{{ui.yourWords}}</text><textarea class="review-input" value="{{reviewDraft}}" maxlength="300" placeholder="{{ui.reviewPlaceholder}}" bindinput="onReviewInput"/><view class="input-count">{{reviewDraft.length}} / 300</view><view aria-role="button" hover-class="tap-hover" class="tap-control primary" data-action="save-review" bindtap="onAction">{{ui.save}}</view></view></scroll-view></view></view>
  <canvas type="2d" id="scene-canvas" class="offscreen-canvas"></canvas><canvas type="2d" id="poster-canvas" class="offscreen-canvas poster-canvas"></canvas>
</view>

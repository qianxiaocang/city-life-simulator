/* WeChat style:v2 gives native buttons a fixed default width. Interactive
   views use the same accessible button role and size to their containers. */
.tap-control{box-sizing:border-box;line-height:1.4;min-width:0}
.tap-hover{opacity:.72}
.advanced-toggle,.birth-button,.details-entry,.earlier,.birth-save-photo{width:100%}
.home-top,.home-controls,.section-head,.overview-top,.overview-top-right{min-width:0}
.home-top{gap:12rpx}
.home-controls{margin-left:auto;gap:12rpx}
.home-controls picker{min-width:0}
.language{min-width:0}
.theme-control{flex:0 0 54rpx}
.text-link{width:auto;white-space:nowrap}
.memorial-previews{gap:18rpx}
.memorial-mini{width:0;flex:1 1 0;min-width:0}
.certificate-actions,.ending-actions{justify-content:space-between;gap:16rpx}
.certificate-actions>.tap-control,.ending-actions>.tap-control{width:0;flex:1 1 0;min-width:0}
.speed-row{gap:6rpx}
.speed-row .control{width:0;flex:1 1 0}
.speed-row .pause-control{flex:1.3 1 0}
.action-row{flex-wrap:wrap}
.action-row .control{flex:0 0 auto}
.life-content{padding-bottom:calc(440rpx + env(safe-area-inset-bottom))}
.auto-notice .tap-control{width:100%;text-align:center}
.music-control .tap-control{width:100%;height:100%}
@media (max-width:360px){
  .home .brand{font-size:27rpx}
  .language{font-size:21rpx}
  .home-controls{gap:6rpx}
  .speed-row .control{font-size:22rpx;padding-left:3rpx;padding-right:3rpx}
  .control{padding-left:15rpx;padding-right:15rpx}
}

/* Keep the status and capsule area opaque while page content scrolls underneath. */
.navigation-background{position:fixed;top:0;left:0;right:0;background:var(--page);z-index:9;pointer-events:none}
.screen-ending .navigation-background{background:#101b15}

/* The custom title and back control share the capsule's navigation row. */
.navigation-bar{position:fixed;left:0;right:0;z-index:10;display:flex;align-items:center;background:var(--page);border-bottom:1rpx solid var(--line)}
.navigation-title{position:absolute;top:0;bottom:0;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:Georgia,"Songti SC",serif;font-size:32rpx;font-weight:700;text-align:center;pointer-events:none}
.screen .navigation-back{position:absolute;left:12px;top:0;bottom:0;min-width:44px;display:flex;align-items:center;justify-content:flex-start;font-family:Arial,sans-serif;font-size:54rpx;line-height:1}
.home-top{justify-content:flex-end;min-height:72rpx}
.home-controls{margin-left:auto}

/* Home settings stay in one compact row beneath the native capsule area. */
.home{padding-top:12rpx}
.home-top{min-height:64rpx}
.home-controls{display:flex;align-items:center;justify-content:flex-end;gap:12rpx}
.language{height:62rpx;min-height:62rpx;padding:5rpx 14rpx 5rpx 6rpx;box-sizing:border-box}
.language-icon{width:42rpx;height:42rpx;font-size:24rpx}
.theme-control{flex:0 0 62rpx;width:62rpx;height:62rpx;border:1rpx solid var(--line);border-radius:50%;background:var(--surface);font-size:34rpx}
.intro{padding-top:14rpx}
.hero-title{display:block;font-size:75rpx;line-height:1.2;margin:12rpx 0 22rpx;letter-spacing:-2rpx}

/* Keep the home settings as one quiet, thumb-sized control. */
.home-controls{gap:0;padding:4rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:18rpx;box-shadow:0 5rpx 18rpx #0000000b}
.home-controls picker{min-width:0}
.language{height:54rpx;min-height:54rpx;padding:0 13rpx;background:transparent;border:0;border-radius:12rpx;box-shadow:none;font-size:23rpx;gap:6rpx}
.language .chevron{margin-left:3rpx;font-size:24rpx}
.theme-control{flex:0 0 56rpx;width:56rpx;height:54rpx;border:0;border-left:1rpx solid var(--line);border-radius:0;background:transparent;font-size:30rpx}

/* Native share button replaces the old image-export action. */
.certificate-actions .birth-share{width:0;flex:1 1 0;min-width:0;margin:0;padding:18rpx 8rpx;min-height:84rpx;line-height:1.4;font-size:26rpx}
.birth-share::after{border:0}
.birth-share[disabled]{opacity:.6}

/* The note editor is a small dialog, never a full-height sheet. */
.review-backdrop{align-items:center;padding:20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom))}
.review-panel{max-height:72vh;border-radius:28rpx;animation:sheet-up .2s ease-out}
.review-panel .modal-head{min-height:76rpx;padding:10rpx 24rpx}
.review-panel .modal-scroll{height:auto;min-height:0;max-height:calc(72vh - 76rpx);flex-shrink:1}
.review-body{padding:20rpx 24rpx 24rpx}
.review-body .review-help{font-size:23rpx;line-height:1.55;margin-bottom:14rpx}
.review-body .field-label{margin-bottom:8rpx}
.review-body .review-input{height:176rpx;box-sizing:border-box}
.review-body .input-count{margin:6rpx 0 15rpx}
.review-body .primary{min-height:76rpx}



/* The home memorial shows two cards at a time and can be swiped to eight. */
.memorial-previews{display:block;width:100%;white-space:nowrap}
.memorial-track{display:inline-flex;align-items:stretch;gap:16rpx;padding-bottom:12rpx}
.memorial-mini{display:block;flex:0 0 calc(50vw - 44rpx);width:calc(50vw - 44rpx);max-width:360rpx;min-width:0;white-space:normal;border:1rpx solid var(--line);box-sizing:border-box;transition:transform .16s ease,box-shadow .16s ease,opacity .16s ease}
.memorial-mini image{display:block;width:100%;height:140rpx}
.memorial-mini>view{padding:16rpx;min-height:90rpx;box-sizing:border-box}
.memorial-mini .mini-name,.memorial-mini .muted{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.memorial-pressed{transform:scale(.965);opacity:.88;box-shadow:0 10rpx 24rpx #0002}

/* Put year and age below the overview label so the fold control stays clear. */
.overview-top{align-items:flex-start;padding-top:22rpx;padding-bottom:12rpx}
.overview-heading{display:flex;flex-direction:column;gap:5rpx;min-width:0}
.overview-year{display:block;color:var(--muted);font-size:23rpx;white-space:nowrap}
.collapse{flex-shrink:0;gap:5rpx;min-height:58rpx;padding:5rpx 14rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--surface2);font-size:23rpx}

/* A shorter choice sheet keeps options reachable on small phones. */
.choice-backdrop{align-items:center;padding:20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom))}
.choice-panel{max-height:72vh;border-radius:28rpx}
.choice-panel .modal-head{min-height:76rpx;padding:12rpx 24rpx}
.choice-panel .modal-scroll{height:auto;max-height:calc(72vh - 76rpx);min-height:0;flex-shrink:1}
.choice-body{padding:20rpx 24rpx 28rpx}
.choice-body .eyebrow{font-size:22rpx}
.choice-title{font-size:34rpx;line-height:1.35;margin:8rpx 0}
.choice-description{font-size:24rpx;line-height:1.55}
.choice-options{margin-top:18rpx}
.choice-option{padding:14rpx 16rpx;margin-bottom:10rpx;border-radius:16rpx}
.option-index{width:32rpx;height:32rpx;font-size:22rpx}
.option-label{font-size:26rpx;line-height:1.45}
.option-description{font-size:22rpx;line-height:1.5;margin-top:3rpx}

.toast{max-width:calc(100vw - 32rpx);padding:18rpx 24rpx;font-size:23rpx;white-space:nowrap;box-sizing:border-box}

/* The overview leaves room for records even while expanded. */
.overview-top{padding:14rpx 22rpx 8rpx;align-items:center}
.overview-heading{flex-direction:row;align-items:baseline;gap:16rpx}
.overview-top .eyebrow{font-size:23rpx;letter-spacing:1rpx}
.overview-year{font-size:21rpx}
.overview .collapse{display:flex;align-items:center;justify-content:center;gap:9rpx;min-height:52rpx;padding:7rpx 12rpx;font-size:22rpx;line-height:1;border-radius:14rpx}
.collapse text{display:block;width:13rpx;height:13rpx;border-right:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:translateY(-3rpx) rotate(45deg);font-size:0;line-height:0}
.collapse text.fold-up{transform:translateY(3rpx) rotate(225deg)}
.overview-person{gap:14rpx;padding:2rpx 22rpx 15rpx}
.overview .avatar{width:64rpx;height:64rpx;border-radius:20rpx;font-size:36rpx}
.overview .person-name{font-size:37rpx;line-height:1.25}
.overview .person-meta{font-size:21rpx;line-height:1.45;margin-top:3rpx}
.overview .stats{gap:16rpx;padding:13rpx 22rpx 16rpx}
.overview .stat-label{font-size:21rpx}
.overview .stat-value{font-size:28rpx;margin:2rpx 0 8rpx}
.overview .stat-track{height:6rpx}
.overview .finances{padding:13rpx 22rpx;gap:10rpx}
.overview .finances .muted{font-size:20rpx}
.overview .finance-value{font-size:26rpx}
.overview .details-entry{min-height:58rpx;padding:12rpx 22rpx;font-size:23rpx}
.overview .auto-notice{padding:0 22rpx 15rpx}
.overview .auto-notice .tap-control{padding:12rpx;font-size:21rpx;border-radius:14rpx}
@media(max-width:340px){.overview-heading{gap:9rpx}.overview-year{font-size:19rpx}.overview-top .eyebrow{font-size:21rpx}}

/* Draw the language arrow geometrically so font baselines cannot shift it. */
.language{align-items:center;gap:12rpx}
.language-label{display:block;line-height:1.2}
.language-chevron{flex:0 0 10rpx;width:10rpx;height:10rpx;box-sizing:border-box;border-right:3rpx solid var(--muted);border-bottom:3rpx solid var(--muted);transform:translateY(-3rpx) rotate(45deg);margin:0 3rpx 0 0}

/* Four compact alternatives fit the choice dialog without a scroll rail. */
.choice-panel{max-height:84vh}
.choice-panel .modal-scroll{height:auto;max-height:none;overflow:hidden}
.choice-body{padding:14rpx 22rpx 18rpx}
.choice-body .choice-title{font-size:30rpx;line-height:1.3;margin:7rpx 0}
.choice-body .choice-description{font-size:22rpx;line-height:1.4}
.choice-options{margin-top:14rpx}
.choice-option{padding:12rpx 14rpx;margin-bottom:8rpx}
.choice-option:last-child{margin-bottom:0}
.choice-body .option-label{font-size:25rpx;line-height:1.35}
.choice-body .option-description{font-size:21rpx;line-height:1.35;margin-top:3rpx}
.choice-body .reflection-input{height:100rpx;margin-top:12rpx;padding:12rpx;font-size:24rpx}
@media(max-height:650px){.choice-body .choice-description{font-size:20rpx}.choice-body .option-description{font-size:20rpx}.choice-option{padding:9rpx 12rpx}.choice-body{padding-top:10rpx;padding-bottom:12rpx}}

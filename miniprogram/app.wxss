page{background:#f4f1e9;color:#292c28;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}view,text,button,picker,textarea{box-sizing:border-box}button{font-family:inherit;font-size:28rpx;line-height:1.4;margin:0;padding:0;background:none;color:inherit;border-radius:0}button::after{border:0}image{display:block;width:100%}button[disabled]{opacity:.42}
